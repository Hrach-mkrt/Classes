// Ресторан 
#include <iostream>
#include <string>
#include <vector>
using namespace std;

// Абстрактный базовый класс: просто позиции меню не бывает, это всегда блюдо или напиток
class MenuItem {
private:
    string name;
    double price;
public:
    MenuItem(string n, double p) : name(n), price(p) {}
    virtual ~MenuItem() {}
    string getName() { return name; }
    double getPrice() { return price; }
    virtual void printInfo() = 0;  // чисто виртуальный метод каждый наследник реализует по-своему
};

// Блюдо: к названию и цене добавляет вес
class Dish : public MenuItem {
private:
    int weight;
public:
    Dish(string n, double p, int w) : MenuItem(n, p), weight(w) {}
    void printInfo() override {
        cout << getName() << " - " << getPrice() << " руб., блюдо, " << weight << " г";
    }
};

// Напиток: к названию и цене добавляет объём
class Drink : public MenuItem {
private:
    int volume;
public:
    Drink(string n, double p, int v) : MenuItem(n, p), volume(v) {}
    void printInfo() override {
        cout << getName() << " - " << getPrice() << " руб., напиток, " << volume << " мл";
    }
};

// Заказ: знает позиции меню (ассоциация), но не владеет ими
class Order {
private:
    int table;
    vector<MenuItem*> items;
public:
    Order(int t) : table(t) {}
    void addItem(MenuItem* item) { items.push_back(item); }
    double getTotal() {
        double sum = 0;
        for (MenuItem* item : items) sum += item->getPrice();
        return sum;
    }
    void printInfo() {
        cout << "Заказ, столик " << table << ":" << endl;
        for (MenuItem* item : items) {
            item->printInfo();  // у блюда и у напитка вызовется своя версия
            cout << endl;
        }
        cout << "Итого: " << getTotal() << " руб." << endl;
    }
};

int main() {
    Dish borscht("Борщ", 350, 300);
    Dish steak("Стейк", 1450, 280);
    Drink wine("Красное вино", 650, 150);
    // MenuItem item("Чай", 100);  // не скомпилируется: MenuItem абстрактный

    Order order(2);
    order.addItem(&borscht);
    order.addItem(&steak);
    order.addItem(&wine);
    order.printInfo();
    return 0;
}
